{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "palm-hours-island",
  "main": "server/worker.js",
  "compatibility_date": "2026-01-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./build/island",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ISLAND",
        "class_name": "Courtyard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Courtyard"
      ]
    }
  ],
  "account_id": "3ed83265f0088dca320423607832e134"
}
